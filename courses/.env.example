# Social Media API Keys (optional - for automated posting)
YOUTUBE_API_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Storage
UPLOAD_DIR=./uploads
CERTIFICATES_DIR=./certificates
THUMBNAILS_DIR=./thumbnails
