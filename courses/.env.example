# AI Course Platform - Environment Variables

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# AI Model Configuration
AI_MODEL=gpt-4
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# Claude API (optional - for production AI generation)
