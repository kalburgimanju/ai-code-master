# AI Product Manager Learning Platform Environment Variables

# OpenRouter API Configuration for AI Model Integration
MODEL="openrouter/free"
ANTHROPIC_AUTH_TOKEN="sk-or-v1-your-key-here"
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# Application Configuration
APP_NAME="AI Product Manager Learning Platform"
APP_VERSION="0.1.0"
NODE_ENV="development"

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL="sqlite:///./data/app.db"
VECTOR_DB_URL="http://localhost:6333"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760  # 10MB in bytes
TEMP_UPLOAD_DIR="./temp_uploads"

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://your-username.github.io/ai-pm-lesson-platform"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes

# API Configuration
API_TIMEOUT=30000  # 30 seconds
MAX_CONCURRENT_ANALYSES=5

# Cache Configuration
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000

# Security
SESSION_SECRET="your-secret-key-change-in-production"
ENCRYPTION_KEY="your-encryption-key-change-in-production"

# Analytics
ANALYTICS_PROVIDER="plausible"
ANALYTICS_DOMAIN="ai-pm-lesson-platform.netlify.app"
PLAIABLE_API_URL="https://plausible.io/api/v1"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@yourdomain.com"

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=false
ENABLE_CHAT_SUPPORT=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_CUSTOM_BRANDING=false

# Learning Platform Configuration
CURRICULUM_VERSION="1.0"
CERTIFICATION_ENABLED=true
MENTORSHIP_ENABLED=true
COMMUNITY_FEATURES_ENABLED=true

# Integration Settings
OPENROUTER_API_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODELS_ENDPOINT="https://openrouter.ai/api/v1/models"

# Monitoring and Logging
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
MAX_LOG_SIZE_MB=10
LOG_ROTATION_COUNT=5

# Backup and Recovery
BACKUP_ENABLED=true
BACKUP_DIRECTORY="./backups"
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_HOURS=24

# External Service Integrations
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""

# Third-party Service API Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Development Settings
development = true
DISABLE_AUTH = false
BYPASS_EMAIL_VERIFICATION = true
DEBUG_MODE = true

# Production Settings
production = true
DISABLE_AUTH = false
BYPASS_EMAIL_VERIFICATION = false
DEBUG_MODE = false