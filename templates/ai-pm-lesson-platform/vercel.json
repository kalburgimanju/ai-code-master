{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "python",
      "buildCommand": "uv run pip install -e ."
    },
    {
      "src": "frontend/package.json",
      "use": "vercel-node",
      "buildCommand": "cd frontend && npm ci && npm run build"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
}