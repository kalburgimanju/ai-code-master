# ATS Resume Analyzer Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (for external AI services if needed)
OPENROUTER_API_KEY=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

# Local development settings
DEBUG=true
LOG_LEVEL=INFO

# File upload settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Analysis settings
ANALYSIS_TIMEOUT=300
MAX_KEYWORDS=100
MAX_SKILLS=50

# CORS settings for frontend
CORS_ORIGINS=http://localhost:3000

# Security
SECRET_KEY=your-secret-key-here

# Database (if using local storage)
DATABASE_URL=sqlite:///ats.db