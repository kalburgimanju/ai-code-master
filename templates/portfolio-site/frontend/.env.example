# Environment variables for the portfolio site frontend

# React App Configuration
REACT_APP_NAME=Comprehensive Portfolio Site
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=A unified portfolio website showcasing AI/ML projects, books authored, and technical expertise.

# API Configuration
REACT_APP_API_URL=https://api.example.com
REACT_APP_WS_URL=wss://api.example.com/ws

# GitHub Integration
REACT_APP_GITHUB_TOKEN=your_github_personal_access_token_here
REACT_APP_GITHUB_USERNAME=your_github_username
REACT_APP_GITHUB_REPO=your_repository

# Book Content API
REACT_APP_BOOKS_API_URL=https://api.example.com/books
REACT_APP_PROJECTS_API_URL=https://api.example.com/projects

# Analytics
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
REACT_APP_GTM_ID=GTM-XXXXX

# Environment
REACT_APP_ENV=development

# Feature Flags
REACT_APP_FEATURE_BOOK_PREVIEW_ENABLED=true
REACT_APP_FEATURE_PROJECT_SEARCH_ENABLED=true
REACT_APP_FEATURE_DARK_MODE_ENABLED=true

# Cache Configuration
REACT_APP_CACHE_DURATION=3600
REACT_APP_CACHE_MAX_ITEMS=100

# Rate Limiting
REACT_APP_RATE_LIMIT_PER_MINUTE=60
REACT_APP_RATE_LIMIT_BURST=10

# Security
REACT_APP_CORS_ORIGIN=https://yourdomain.com
REACT_APP_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';

# Logging
REACT_APP_LOG_LEVEL=info
REACT_APP_LOG_OUTPUT=console

# Performance
REACT_APP_ENABLE_PERF_MEASURING=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true

# Development Server
REACT_APP_DEV_PORT=3000
REACT_APP_DEV_HOST=0.0.0.0

# Production Configuration
REACT_APP_BUILD_PATH=dist
REACT_APP_PUBLIC_URL=/portfolio-site/
REACT_APP_STATIC_ASSETS=true

# Book Specific Configuration
REACT_APP_BOOK_CACHE_ENABLED=true
REACT_APP_BOOK_CHAPTERS_PER_PAGE=2
REACT_APP_BOOK_SEARCH_ENABLED=true

# Project Specific Configuration
REACT_APP_PROJECTS_PER_PAGE=12
REACT_APP_PROJECT_FILTER_ENABLED=true
REACT_APP_PROJECT_SEARCH_ENABLED=true

# User Preferences
REACT_APP_DEFAULT_THEME=light
REACT_APP_ENABLE_ANIMATIONS=true
REACT_APP_ENABLE_TRANSITIONS=true
REACT_APP_ENABLE_GRADIENTS=true

# External Services
REACT_APP_GITHUB_API_URL=https://api.github.com
REACT_APP_NETLIFY_API_URL=https://api.netlify.com
REACT_APP_VERCEL_API_URL=https://api.vercel.com

# Backends
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_BACKEND_API_BASE=/api