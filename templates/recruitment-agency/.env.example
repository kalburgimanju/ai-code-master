# ============================================================
# REQUIRED: LLM API Key
# ============================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================
# OPTIONAL: External API Keys
# ============================================================

# Apify (LinkedIn scraping)
APIFY_API_TOKEN=

# SendGrid (email delivery)
SENDGRID_API_KEY=

# Cal.com (calendar scheduling)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=

# HubSpot (CRM sync)
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=

# Crunchbase (company data)
CRUNCHBASE_API_KEY=

# ============================================================
# OPTIONAL: Database
# ============================================================
# Default: sqlite:///./data/agency.db
DATABASE_URL=sqlite+aiosqlite:///./data/agency.db

# ============================================================
# OPTIONAL: Monitoring
# ============================================================
SENTRY_DSN=
SLACK_WEBHOOK_URL=
