# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: referer/site metadata sent to OpenRouter
OPENROUTER_REFERER=https://seedance2.local
OPENROUTER_SITE_NAME=Seedance 2 Clone

# Model used for the chat/orchestration agents (prompt enhancement, storyboard, etc.)
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-sonnet

# Model used for image generation (must support image generation on OpenRouter)
OPENROUTER_IMAGE_MODEL=openai/dall-e-3

# Server-side secret used to sign generated task ids (optional)
SEEDANCE_TASK_SECRET=change-me
