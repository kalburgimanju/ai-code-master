# ============================================================================
# Student WhatsApp CRM — environment configuration
# Copy to .env (the backend reads it automatically via @nestjs/config).
# Mock adapters are the DEFAULT and require NO credentials — the platform runs
# end-to-end with these defaults.
# ============================================================================

# ---- Backend ----
PORT=4000
NODE_ENV=development

# Database: leave DATABASE_URL unset to use local SQLite (data/crm.db).
# Set it to a postgres:// URL to use PostgreSQL instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/crm

# ---- Queue ----
# Leave REDIS_URL unset to use the in-memory queue (no Redis needed for dev/demo).
# Set it to a redis:// URL to use BullMQ (production).
# REDIS_URL=redis://localhost:6379

# ---- WhatsApp provider ----
# mock | cloud | twilio | interakt
WHATSAPP_PROVIDER=mock
# Only needed when WHATSAPP_PROVIDER != mock:
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
# WHATSAPP_CLOUD_RECIPIENT_PHONE_ID=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_WHATSAPP_FROM=
# INTERAKT_API_KEY=
# INTERAKT_ACCOUNT_ID=

# ---- AI provider ----
# mock | openai | openrouter
AI_PROVIDER=mock
# OpenRouter (OpenAI-compatible, free models): set AI_PROVIDER=openrouter and the key below.
# OPENROUTER_API_KEY=
# Free models (default: openai/gpt-oss-20b:free). Free slugs rotate on
# OpenRouter; if one 404s/429s, switch to another :free model. Any of:
#   openai/gpt-oss-20b:free
#   meta-llama/llama-3.3-70b-instruct:free
#   meta-llama/llama-3.2-3b-instruct:free
#   nousresearch/hermes-3-llama-3.1-405b:free
#   qwen/qwen3-next-80b-a3b-instruct:free
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Only needed when AI_PROVIDER=openai:
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Payment provider ----
# mock | razorpay | stripe
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=

# ---- Frontend ----
# VITE_API_BASE is used by the dashboard; proxied through Vite in dev.
VITE_API_BASE=/api
