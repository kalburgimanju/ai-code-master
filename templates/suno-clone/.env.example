# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: referer/site metadata sent to OpenRouter
OPENROUTER_REFERER=https://suno-clone.local
OPENROUTER_SITE_NAME=Suno Clone

# Free chat model used for lyrics + style (must be a FREE model on OpenRouter)
OPENROUTER_CHAT_MODEL=openrouter/auto

# Free Hugging Face music model (text-to-audio). musicgen-small is free.
HF_MUSIC_MODEL=facebook/musicgen-small

# Hugging Face token — optional. Improves rate limits on the free Inference API.
HF_TOKEN=

# Auth.js / NextAuth configuration (demo credentials: demo@example.com / password)
AUTH_SECRET=change-me
