# VGenerator — Environment Variables
# Copy this to .env and fill in your API keys

# For OpenRouter (recommended)
MPT_LLM_PROVIDER=oneapi
MPT_LLM_API_KEY=sk-or-v1-your-openrouter-key
MPT_LLM_BASE_URL=https://openrouter.ai/api/v1
MPT_LLM_MODEL_NAME=openrouter/free

# For Pexels stock footage (free: https://www.pexels.com/api/)
MPT_PEXELS_API_KEY=your-pexels-api-key

# Server
VGEN_PORT=8090
