# Video Lesson Planner Environment Variables

# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# YouTube Data API v3 (OAuth2 credentials from Google Cloud Console)
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback

# Google Drive (reuses the same OAuth token as YouTube)
# Create two folders in Google Drive (a script folder and a presentations folder),
# then either share them with the OAuth account or open them and copy the ID from
# the URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_SCRIPT_FOLDER_ID=
GOOGLE_DRIVE_PPT_FOLDER_ID=

# Database
DATABASE_URL=sqlite:///./data/lesson_planner.db

# App
APP_NAME=Video Lesson Planner
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
