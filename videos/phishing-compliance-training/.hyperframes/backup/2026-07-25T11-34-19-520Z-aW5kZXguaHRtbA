    html { margin: 0; width: 1920px; height: 1080px; overflow: hidden; }
    body { margin: 0; width: 1920px; height: 1080px; overflow: hidden; background: #0C1B33; --accent: #00C9A7; --warn: #FFB347; --danger: #FF4757; }
    body { font-family: 'Inter', sans-serif; }
    code, pre, .monospace { font-family: 'JetBrains Mono', monospace; }

    #root {
      position: relative;
      width: 1920px;
      height: 1080px;
      overflow: hidden;
      background: radial-gradient(ellipse at 30% 20%, #1A3263 0%, #0C1B33 70%);
    }

    .scene {
      position: absolute;
      inset: 0;
      width: 1920px;
      height: 1080px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 160px;
    }

    .scene-left {
      align-items: flex-start;
      justify-content: center;
    }

    .safe-zone { width: 1600px; max-width: 1600px; }

    .headline-xl { font-weight: 800; font-size: 72px; color: #FFFFFF; line-height: 1.1; letter-spacing: -0.02em; }
    .headline-lg { font-weight: 700; font-size: 56px; color: #FFFFFF; line-height: 1.15; letter-spacing: -0.01em; }
    .headline-md { font-weight: 700; font-size: 40px; color: #FFFFFF; line-height: 1.2; }
    .headline-sm { font-weight: 600; font-size: 30px; color: #FFFFFF; line-height: 1.3; }

    .body-lg { font-weight: 400; font-size: 24px; color: #B0BEC5; line-height: 1.6; }
    .body-md { font-weight: 400; font-size: 20px; color: #B0BEC5; line-height: 1.5; }

    .accent-text { color: var(--accent, #00C9A7); }
    .warn-text { color: var(--warn, #FFB347); }
    .danger-text { color: var(--danger, #FF4757); }
    .glow-accent { text-shadow: 0 0 30px rgba(0,201,167,0.4); }
    .glow-warn { text-shadow: 0 0 30px rgba(255,179,71,0.4); }
    .glow-danger { text-shadow: 0 0 30px rgba(255,71,87,0.4); }

    .mt-8 { margin-top: 8px; }
    .mt-16 { margin-top: 16px; }
    .mt-24 { margin-top: 24px; }
    .mt-32 { margin-top: 32px; }
    .mt-48 { margin-top: 48px; }
    .mt-64 { margin-top: 64px; }

    .card {
      background: rgba(26,50,99,0.7);
      border-radius: 12px;
      padding: 28px 32px;
