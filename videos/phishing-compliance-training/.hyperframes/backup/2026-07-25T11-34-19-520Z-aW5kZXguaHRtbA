    .type-card.warn-card { border-top-color: var(--warn, #FFB347); }
    .type-card.danger-card { border-top-color: var(--danger, #FF4757); }
    .type-card-icon {
      width: 44px; height: 44px; background: rgba(0,201,167,0.12); border-radius: 10px;
      display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 12px;
    }
    .type-card.warn-card .type-card-icon { background: rgba(255,179,71,0.12); }
    .type-card.danger-card .type-card-icon { background: rgba(255,71,87,0.12); }
    .type-card-name { font-weight: 700; font-size: 20px; color: #FFFFFF; margin-bottom: 6px; }
    .type-card-desc { font-size: 15px; color: #B0BEC5; line-height: 1.5; }

    .watchlist { width: 1400px; }
    .watchlist-item {
      display: flex; align-items: flex-start; gap: 20px;
      padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .watchlist-number {
      width: 40px; min-width: 40px; height: 40px;
      background: rgba(0,201,167,0.15); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 18px; color: var(--accent, #00C9A7);
    }
    .watchlist-number.danger { background: rgba(255,71,87,0.15); color: var(--danger, #FF4757); }
    .watchlist-number.warn { background: rgba(255,179,71,0.15); color: var(--warn, #FFB347); }
    .watchlist-content { flex: 1; }
    .watchlist-title { font-weight: 700; font-size: 22px; color: #FFFFFF; }
    .watchlist-desc { font-size: 18px; color: #B0BEC5; margin-top: 4px; }

    .action-step { display: flex; align-items: center; gap: 32px; padding: 20px; max-width: 1400px; }
    .action-icon {
      width: 64px; height: 64px; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; flex-shrink: 0;
    }
    .action-icon.dont-icon { background: rgba(255,71,87,0.12); color: #FF4757; }
    .action-icon.do-icon { background: rgba(0,201,167,0.12); color: #00C9A7; }

    .end-lockup { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .brand-mark {
      width: 80px; height: 80px; background: var(--accent, #00C9A7); border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      font-size: 36px; font-weight: 800; color: #0C1B33;
    }

    .accent-line { width: 60px; height: 4px; background: var(--accent, #00C9A7); border-radius: 2px; margin: 16px 0; }
    .danger-line { width: 60px; height: 4px; background: var(--danger, #FF4757); border-radius: 2px; margin: 16px 0; }

    .deco-grid {
      position: absolute; inset: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
      background-size: 80px 80px;
    }
    .deco-dot {
      position: absolute; width: 6px; height: 6px; border-radius: 50%;
      background: rgba(0,201,167,0.15); pointer-events: none;
    }

    .section-indicator {
      position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
      display: flex; gap: 8px;
    }
    .section-dot { width: 48px; height: 3px; border-radius: 2px; background: rgba(255,255,255,0.15); }
    .section-dot.active { background: var(--accent, #00C9A7); }
