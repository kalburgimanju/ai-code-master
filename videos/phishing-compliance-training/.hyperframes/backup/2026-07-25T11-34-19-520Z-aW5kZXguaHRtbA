    .email-header { background: #1A3263; padding: 16px 24px; display: flex; align-items: center; gap: 12px; }
    .email-body { padding: 24px 32px; }
    .email-field { display: flex; padding: 6px 0; font-size: 16px; color: #B0BEC5; }
    .email-field-label { color: #A0B4C8; width: 80px; flex-shrink: 0; font-family: 'JetBrains Mono', monospace; font-size: 14px; }
    .email-field-value { color: #FFFFFF; font-family: 'JetBrains Mono', monospace; font-size: 14px; }
    .email-field-value.suspicious { color: #FF4757; }
    .email-divider { height: 1px; background: #1A3263; margin: 12px 0; }
    .email-subject { font-weight: 700; font-size: 20px; color: #FFFFFF; margin-bottom: 12px; }
    .email-content { font-size: 16px; color: #B0BEC5; line-height: 1.6; }
    .email-btn { display: inline-block; background: #1A3263; color: #FFFFFF; padding: 12px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; margin-top: 16px; }

    .type-grid { display: flex; flex-wrap: wrap; gap: 16px; width: 1600px; }
    .type-card {
      width: 380px; background: rgba(26,50,99,0.6); border-radius: 12px;
      padding: 24px; border-top: 3px solid var(--accent, #00C9A7); backdrop-filter: blur(4px);
