    .card-warn { border-left-color: var(--warn, #FFB347); }
    .card-danger { border-left-color: var(--danger, #FF4757); }

    .stat-row { display: flex; justify-content: center; gap: 64px; }
    .stat-item { text-align: center; }
    .stat-number { font-weight: 800; font-size: 72px; line-height: 1; color: #FFFFFF; }
    .stat-label { font-weight: 500; font-size: 18px; color: #A0B4C8; margin-top: 8px; }

    .email-mockup {
      background: #0C1B33; border: 1px solid #1A3263; border-radius: 12px;
      width: 1000px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.5);
